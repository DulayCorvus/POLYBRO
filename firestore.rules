rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allowlist of admin UIDs. Existence of the doc = admin; content doesn't
    // matter. Managed manually from the Firebase console (or an Admin SDK
    // script) — never writable from a client, admin or not, so a compromised
    // or buggy client can never grant itself access.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // One doc per learner per track, holding their full STATE. cpp.html
    // uses `progress`, htmlcss_1.html uses `progress_htmlcss` — genuinely
    // separate collections (confirmed in both files), not a shared
    // namespace, so both need the identical rule shape below. A learner
    // can only ever read/write their own doc directly. `list` (a
    // collection-wide query, e.g. admin.html's aggregate fetch) is
    // admin-only — this is the fix for the pre-existing leaderboard
    // exposure: nothing here lets a learner enumerate or bulk-read other
    // learners' full progress docs anymore.
    match /progress/{uid} {
      allow get, write: if request.auth != null && request.auth.uid == uid;
      allow list: if request.auth != null
                  && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /progress_htmlcss/{uid} {
      allow get, write: if request.auth != null && request.auth.uid == uid;
      allow list: if request.auth != null
                  && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Denormalized public snapshot for each track's Leaderboard screen —
    // only the fields that screen displays (name/xp/streak/etc), written
    // by the owning learner alongside their real progress save. Readable
    // by any signed-in learner (that's the point of a leaderboard), but it
    // never contains quiz answers, review schedule, or anything else from
    // the real STATE doc. Same track-separation as above.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /leaderboard_htmlcss/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
